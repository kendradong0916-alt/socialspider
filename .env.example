# ── Supabase ────────────────────────────────────────────────
# From: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhb...
SUPABASE_SERVICE_ROLE_KEY=eyJhb...   # kept server-side only

# ── Skyvern ─────────────────────────────────────────────────
# From: https://app.skyvern.com/settings (or your self-hosted instance)
SKYVERN_API_KEY=sk-...
SKYVERN_API_URL=https://api.skyvern.com/api/v1   # default cloud endpoint

# ── App ─────────────────────────────────────────────────────
# Full public URL of this deployment (used to build the webhook callback URL)
# On Vercel this is set automatically via VERCEL_URL; override if using a custom domain
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
